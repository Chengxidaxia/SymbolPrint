{
  "Version": 1,
  "General": {
    "Theme": "System",
    "AutoBackupOriginal": true,
    "BackupSuffix": ".bak",
    "ValidateBeforeOpen": true
  },
  "Crypto": {
    "Curve": "nistP256",
    "Pbkdf2Iterations": 40000,
    "Pbkdf2SaltBytes": 16,
    "DerivedKeyBytes": 32,
    "AesKeyBits": 256,
    "GcmTagBytes": 16,
    "HkdfInfo": "SymbolPrint-ECIES-v1",
    "ProtectStampKeyByDefault": false,
    "UnlockKeepMinutes": 0
  },
  "Compression": {
    "Algorithm": "Brotli",
    "BrotliQuality": 9,
    "MinSizeToCompress": 256,
    "BlockSizeKb": 1024,
    "SkipIfLarger": true,
    "SealBytesMax": 67108864
  },
  "Carriers": {
    "PreferredOrder": "trailer,zip-comment,7z-tail,rtf-group,zero-width",
    "ZipCommentMaxBytes": 65535,
    "ZeroWidthPair": "200B,200C",
    "RtfGroupName": "symprint",
    "VerifyOnOpen": false
  },
  "Image": {
    "MaxWidthPx": 1200,
    "MaxHeightPx": 1200,
    "OpacityPercent": 100,
    "Anchor": "Custom",
    "OffsetXPx": 24,
    "OffsetYPx": 24,
    "MarginPx": 24,
    "RotationDegrees": 0,
    "Rasterizer": "WebView2",
    "TransparentBackground": true,
    "AntiAlias": true,
    "JpegQuality": 92,
    "PreserveExif": true
  },
  "Pdf": {
    "PageSelection": "all",
    "Dpi": 200,
    "WidthMm": 40,
    "Anchor": "Custom",
    "OffsetXMm": 10,
    "OffsetYMm": 10,
    "BehindContent": false
  },
  "Verify": {
    "StrictMode": true,
    "WarnIfNoSeal": true,
    "CheckOriginalHash": true,
    "CheckStampId": true,
    "CheckOwnHash": true,
    "CheckTimestampOrder": true,
    "ShowRawHex": false,
    "ReportFormat": "Text",
    "CopyReportToClipboard": false
  },
  "Progress": {
    "Enabled": true,
    "DelayMs": 250,
    "ThrottleMs": 60,
    "ShowIndeterminate": true,
    "ShowBytesDetail": true,
    "CancelOnEsc": true
  },
  "Ui": {
    "FontSize": 9,
    "ConfirmBeforeOverwrite": true,
    "ShowAdvancedByDefault": false,
    "RememberWindowBounds": false,
    "ReopenLastFile": false,
    "ShowStampDescription": true
  }
}