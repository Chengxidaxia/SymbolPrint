<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <RootNamespace>SymbolPrint.Core</RootNamespace>
    <AssemblyName>SymbolPrint.Core</AssemblyName>
    <OutputType>Library</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <PackageReference Include="PDFsharp" Version="1.50.5147" />
    <PackageReference Include="Svg" Version="3.4.8" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.10" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- 语言包内嵌：Core 自己加载，不依赖安装目录里多几个文件。zh_CN 是原文，不需要文件 -->
    <EmbeddedResource Include="..\..\assets\i18n\en_US.json" LogicalName="en_US.json" />
    <EmbeddedResource Include="..\..\assets\i18n\zh_TW.json" LogicalName="zh_TW.json" />
    <EmbeddedResource Include="..\..\assets\i18n\zh_AL.json" LogicalName="zh_AL.json" />
  </ItemGroup>

</Project>
