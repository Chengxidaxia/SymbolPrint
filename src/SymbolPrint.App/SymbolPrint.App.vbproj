<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace></RootNamespace>
    <AssemblyName>SymbolPrint</AssemblyName>
    <StartupObject>App.Program</StartupObject>
    <!-- 程序图标：红章造型，多尺寸 256/128/64/48/32/24/16 都内置在同一枚 .ico 里 -->
    <ApplicationIcon>..\..\assets\symbolprint.ico</ApplicationIcon>
    <MyType>WindowsForms</MyType>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <ApplicationUseCompatibleTextRendering>false</ApplicationUseCompatibleTextRendering>
    <ApplicationDefaultFont>Microsoft YaHei UI, 9pt</ApplicationDefaultFont>
    <OptionStrict>On</OptionStrict>
    <OptionExplicit>On</OptionExplicit>
    <OptionInfer>On</OptionInfer>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SymbolPrint.Core\SymbolPrint.Core.vbproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3351.48" />
  </ItemGroup>

  <ItemGroup>
    <!-- 图案编辑器：SVG-Edit 7.4.2（MIT）原样随包分发，运行时走虚拟主机映射到 <程序目录>\editor\
         多文件（js/css/images/extensions）无法用 NavigateToString 加载，必须落盘。
         ExcludeFromSingleFile 不能省：自包含单文件发布会把大体积 .js 打进 exe，
         结果 editor 目录里少了 iife-Editor.js / Editor.js，编辑器直接报"内核未加载"。 -->
    <None Include="..\..\assets\editor\svgedit\**\*"
          Link="editor\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          ExcludeFromSingleFile="true" />
  </ItemGroup>

  <ItemGroup>
    <!-- 第三方许可（LICENSE-MIT.txt / licenseInfo.json）已在 svgedit 目录内，随上面的通配一起复制 -->
  </ItemGroup>


</Project>
