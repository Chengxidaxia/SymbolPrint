# ---- 构建产物 ----
bin/
obj/
dist/
publish/
*.user
*.suo
.vs/

# ---- 解压出来的绿色版目录（含 exe/dll 与运行数据，发布走 Release 附件）----
SymbolPrint-win-x64/

# ---- WebView2 运行时数据（浏览器 Profile / 缓存：History、Cookies、Local Storage）----
# 属于用户本机数据，绝不能入库；v1.1.0 起程序已把它移到 %LOCALAPPDATA%\SymbolPrint\WebView2
*.WebView2/
**/*.WebView2/

# ---- 本地临时/诊断产物 ----
.build/
*.log
*.tmp

# ---- 项目内部数据（含工作记忆，不公开） ----
.workbuddy/

# ---- NuGet 还原的本地缓存（若有人改到仓库内） ----
packages/
*.nupkg

# ---- 系统 ----
Thumbs.db
desktop.ini
.DS_Store

# 本机 NuGet 配置（含本机绝对路径，不公开）
nuget.config
